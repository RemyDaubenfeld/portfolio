{# Éléments de formulaire partagés par les écrans d'authentification #}

{% macro label(for, text) %}
    <label for="{{ for }}" class="font-mono text-[0.75rem] text-text-mute uppercase tracking-[0.08em] block mb-[0.4rem]">
        {{ text }}
    </label>
{% endmacro %}

{% macro input_class() %}w-full px-3 py-[0.6rem] bg-bg border border-border rounded-md text-text text-[0.95rem] transition-all duration-200 focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold{% endmacro %}

{% macro submit(text) %}
    <button type="submit"
            class="w-full font-mono text-[0.8rem] tracking-[0.06em] uppercase text-bg bg-gold border border-gold py-[0.75rem] rounded-md font-semibold transition-opacity duration-200 hover:opacity-85 mt-2">
        {{ text }}
    </button>
{% endmacro %}

{% macro error(message) %}
    <div class="bg-red-950 border border-red-800 text-red-300 text-[0.875rem] px-3 py-[0.6rem] rounded-md mb-5">
        {{ message }}
    </div>
{% endmacro %}

{% macro success(message) %}
    <div class="bg-green-950 border border-green-800 text-green-300 text-[0.875rem] px-3 py-[0.6rem] rounded-md mb-5">
        {{ message }}
    </div>
{% endmacro %}

{% macro link(href, text) %}
    <a href="{{ href }}" class="font-mono text-[0.75rem] text-text-mute hover:text-gold transition-colors duration-200">{{ text }}</a>
{% endmacro %}
