{% extends '@EasyAdmin/page/content.html.twig' %}

{% macro action_button(controller, action, entityId, label, icon, variant) %}
    <form method="post" action="{{ ea_url().setController(controller).setAction(action).setEntityId(entityId) }}">
        <button type="submit" class="btn btn-sm btn-{{ variant }}"><i class="{{ icon }}"></i> {{ label }}</button>
    </form>
{% endmacro %}

{% set offerCrud = 'App\\Controller\\JobSearch\\JobOfferCrudController' %}
{% set applicationCrud = 'App\\Controller\\JobSearch\\JobApplicationCrudController' %}
{% set companyCrud = 'App\\Controller\\JobSearch\\CompanyCrudController' %}

{% block page_title %}Tableau de bord{% endblock %}

{% block main %}
<style>
    .js-kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 1rem; margin-bottom: 1.5rem; }
    /* Une teinte par groupe de blocs : couleur semi-transparente, lisible en thème clair comme sombre */
    .js-tone-stats { --tone: 59, 130, 246; }   /* bleu : indicateurs */
    .js-tone-offers { --tone: 16, 185, 129; }  /* vert : offres et candidatures en cours */
    .js-tone-follow { --tone: 245, 158, 11; }  /* ambre : relances et entretiens */
    .js-tone-company { --tone: 139, 92, 246; } /* violet : entreprises */

    .js-kpi { display: block; padding: 1rem 1.25rem; border: 1px solid rgba(var(--tone), .3); border-radius: 10px;
              background: rgba(var(--tone), .08); color: inherit; text-decoration: none; }
    .js-kpi:hover { opacity: .85; }
    .js-kpi-label { font-size: .8rem; opacity: .7; }
    .js-kpi-value { font-size: 1.8rem; font-weight: 600; line-height: 1.2; font-variant-numeric: tabular-nums; }
    .js-kpi-sub { font-size: .78rem; opacity: .7; }
    .js-kpi.is-alert { border-color: var(--bs-warning, #f59e0b); box-shadow: inset 0 0 0 1px var(--bs-warning, #f59e0b); }

    /* 2 colonnes, une seule sous 1100px ; minmax(0, 1fr) laisse les colonnes rétrécir au lieu de déborder */
    .js-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; }
    .js-wide { grid-column: 1 / -1; }
    @media (max-width: 1100px) { .js-grid { grid-template-columns: minmax(0, 1fr); } }

    .js-panel { border: 1px solid rgba(var(--tone), .3); border-radius: 10px; padding: 1rem 1.25rem; overflow-x: auto;
                background: rgba(var(--tone), .07); }
    .js-panel h2 i { color: rgb(var(--tone)); }
    /* Les tableaux Bootstrap peignent leur propre fond : on le rend transparent pour laisser voir la teinte */
    .js-panel .table { --bs-table-bg: transparent; background: transparent; }
    .js-panel .table > :not(caption) > * > * { background-color: transparent; border-bottom-color: rgba(var(--tone), .2); }
    .js-panel h2 { font-size: 1rem; font-weight: 600; margin-bottom: .75rem; display: flex; align-items: center; gap: .5rem; }
    .js-count { font-size: .75rem; font-weight: 500; opacity: .6; }
    .js-panel table { margin-bottom: 0; }
    .js-panel td { vertical-align: middle; }
    .js-sub { font-size: .8rem; opacity: .7; }
    .js-nowrap { white-space: nowrap; }
    .js-due { color: var(--bs-warning, #f59e0b); font-weight: 600; }
    .js-actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: .35rem; }
    .js-actions .btn { white-space: nowrap; }
    .js-empty { opacity: .6; font-size: .9rem; margin: 0; }
    .js-more { display: inline-block; margin-top: .6rem; font-size: .85rem; }

    .js-companies { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 0 2.5rem; }
    .js-companies h3 { font-size: .8rem; font-weight: 600; text-transform: uppercase; letter-spacing: .04em; opacity: .7; margin-bottom: .4rem; }
</style>

{# --- Indicateurs --- #}
{% set nextFollowUp = awaitingApplications|filter(a => a.followUpAt)|first %}
<div class="js-kpis js-tone-stats">
    <a class="js-kpi" href="#offres">
        <div class="js-kpi-label">Offres à étudier</div>
        <div class="js-kpi-value">{{ offersToReview }}</div>
        <div class="js-kpi-sub">{{ offersLast7Days }} reçue(s) ces 7 derniers jours</div>
    </a>
    <a class="js-kpi" href="#candidatures">
        <div class="js-kpi-label">Candidatures en cours</div>
        <div class="js-kpi-value">{{ applications.awaiting }}</div>
        <div class="js-kpi-sub">{{ applications.sent }} envoyée(s) au total ({{ applications.jobPosting }} annonce · {{ applications.spontaneous }} spontanée) · {{ applications.last7Days }} cette semaine</div>
    </a>
    <div class="js-kpi">
        <div class="js-kpi-label">Taux de réponse</div>
        <div class="js-kpi-value">{{ responseRate is null ? '—' : responseRate ~ ' %' }}</div>
        <div class="js-kpi-sub">{{ applications.answered }} réponse(s) sur {{ applications.sent }} candidature(s)</div>
    </div>
    <a class="js-kpi {{ followUpsDue|length > 0 ? 'is-alert' }}" href="#relances">
        <div class="js-kpi-label">Relances à faire</div>
        <div class="js-kpi-value">{{ followUpsDue|length }}</div>
        <div class="js-kpi-sub">
            {%- if followUpsDue is not empty -%}
                à faire dès maintenant
            {%- elseif nextFollowUp -%}
                prochaine le {{ nextFollowUp.followUpAt|date('d/m/Y') }}
            {%- else -%}
                aucune de prévue
            {%- endif -%}
        </div>
    </a>
    <a class="js-kpi" href="#entretiens">
        <div class="js-kpi-label">Entretiens en cours</div>
        <div class="js-kpi-value">{{ applications.interviews }}</div>
    </a>
    <a class="js-kpi" href="#entreprises">
        <div class="js-kpi-label">Entreprises</div>
        <div class="js-kpi-value">{{ companiesTotal }}</div>
        <div class="js-kpi-sub">{{ companiesByStatus|filter(s => s.status.value in ['to_qualify', 'to_contact'])|map(s => s.total ~ ' ' ~ s.status.label|lower)|join(' · ') }}</div>
    </a>
</div>

<div class="js-grid">

    {# ===== Ligne 1 : offres à étudier / candidatures en cours ===== #}

    <section class="js-panel js-tone-offers" id="offres">
        <h2><i class="fa fa-briefcase"></i> Offres à étudier <span class="js-count">{{ offersToReview }}</span></h2>
        {% if latestOffers is empty %}
            <p class="js-empty">Aucune offre en attente.</p>
        {% else %}
            <table class="table table-sm">
                <thead><tr><th>Offre</th><th>Lieu</th><th></th></tr></thead>
                <tbody>
                {% for offer in latestOffers %}
                    <tr>
                        <td>
                            <a href="{{ offer.url }}" target="_blank" rel="noopener">{{ offer.title }}</a>
                            <div class="js-sub">{{ offer.company ?? 'Entreprise non précisée' }} · {{ offer.source }}</div>
                        </td>
                        <td>{{ offer.location }}</td>
                        <td>
                            <div class="js-actions">
                                {{ _self.action_button(offerCrud, 'apply', offer.id, 'Postuler', 'fa fa-paper-plane', 'success') }}
                                {{ _self.action_button(offerCrud, 'notInterested', offer.id, 'Pas intéressé', 'fa fa-ban', 'secondary') }}
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
            {% if offersToReview > latestOffers|length %}
                <a class="js-more" href="{{ ea_url().setController(offerCrud).setAction('index') }}">Voir les {{ offersToReview }} offres à étudier →</a>
            {% endif %}
        {% endif %}
    </section>

    <section class="js-panel js-tone-offers" id="candidatures">
        <h2><i class="fa fa-paper-plane"></i> Candidatures en cours <span class="js-count">{{ awaitingApplications|length }}</span></h2>
        {% if awaitingApplications is empty %}
            <p class="js-empty">Aucune candidature en attente de réponse.</p>
        {% else %}
            <table class="table table-sm">
                <thead><tr><th>Candidature</th><th>Envoyée</th><th>Relance prévue</th></tr></thead>
                <tbody>
                {% for application in awaitingApplications %}
                    <tr>
                        <td>
                            <a href="{{ ea_url().setController(applicationCrud).setAction('detail').setEntityId(application.id) }}">
                                {{ application.offer ? application.offer.title : 'Candidature spontanée' }}
                            </a>
                            <div class="js-sub">
                                {{ application.company ? application.company.name : (application.offer.company ?? 'Entreprise inconnue') }}
                                {% if application.followUpCount > 0 %} · {{ application.followUpCount }} relance(s){% endif %}
                            </div>
                        </td>
                        <td class="js-nowrap">{{ application.sentAt ? application.sentAt|date('d/m/Y') }}</td>
                        <td class="js-nowrap {{ application.followUpDue ? 'js-due' }}">
                            {{ application.followUpAt ? application.followUpAt|date('d/m/Y') : '—' }}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </section>

    {# ===== Ligne 2 : relances à faire / entretiens en cours ===== #}

    <section class="js-panel js-tone-follow" id="relances">
        <h2><i class="fa fa-bell"></i> Relances à faire <span class="js-count">{{ followUpsDue|length }}</span></h2>
        {% if followUpsDue is empty %}
            <p class="js-empty">Aucune relance en attente.</p>
        {% else %}
            <table class="table table-sm">
                <thead><tr><th>Candidature</th><th>Envoyée</th><th></th></tr></thead>
                <tbody>
                {% for application in followUpsDue %}
                    <tr>
                        <td>
                            <a href="{{ ea_url().setController(applicationCrud).setAction('detail').setEntityId(application.id) }}">{{ application }}</a>
                            <div class="js-sub">
                                {{ application.followUpCount }} relance(s) déjà faite(s)
                                {% if application.company and application.company.contactEmail %} · {{ application.company.contactEmail }}{% endif %}
                            </div>
                        </td>
                        <td class="js-nowrap">{{ application.sentAt ? application.sentAt|date('d/m/Y') }}</td>
                        <td>
                            <div class="js-actions">
                                {{ _self.action_button(applicationCrud, 'followUp', application.id, 'Relancé', 'fa fa-bell', 'warning') }}
                                {{ _self.action_button(applicationCrud, 'noResponse', application.id, 'Sans réponse', 'fa fa-hourglass-end', 'secondary') }}
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </section>

    <section class="js-panel js-tone-follow" id="entretiens">
        <h2><i class="fa fa-handshake"></i> Entretiens en cours <span class="js-count">{{ interviews|length }}</span></h2>
        {% if interviews is empty %}
            <p class="js-empty">Aucun entretien en cours.</p>
        {% else %}
            <table class="table table-sm">
                <tbody>
                {% for application in interviews %}
                    <tr>
                        <td>
                            <a href="{{ ea_url().setController(applicationCrud).setAction('detail').setEntityId(application.id) }}">{{ application }}</a>
                            {% if application.notes %}<div class="js-sub">{{ application.notes|length > 120 ? application.notes|slice(0, 120) ~ '…' : application.notes }}</div>{% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </section>

    {# ===== Ligne 3 : entreprises ===== #}

    <section class="js-panel js-wide js-tone-company" id="entreprises">
        <h2><i class="fa fa-building"></i> Entreprises <span class="js-count">{{ companiesTotal }}</span></h2>
        {% if companiesTotal == 0 %}
            <p class="js-empty">Aucune entreprise enregistrée. Importer la liste avec <code>php bin/console app:job-search:import-companies</code>.</p>
        {% else %}
            <div class="js-companies">
                <div>
                    <h3>Par statut</h3>
                    <table class="table table-sm">
                        <tbody>
                        {% for item in companiesByStatus %}
                            <tr>
                                <td>
                                    <a href="{{ ea_url().setController(companyCrud).setAction('index').set('filters', {status: {comparison: '=', value: item.status.value}}) }}">
                                        <span class="badge badge-{{ item.status.color }}">{{ item.status.label }}</span>
                                    </a>
                                </td>
                                <td class="text-end">{{ item.total }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
                <div>
                    <h3>Par région</h3>
                    <table class="table table-sm">
                        <tbody>
                        {% for region, total in companiesByRegion %}
                            <tr><td>{{ region }}</td><td class="text-end">{{ total }}</td></tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        {% endif %}
    </section>

</div>
{% endblock %}
