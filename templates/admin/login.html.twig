{# templates/admin/login.html.twig #}
{% extends 'admin/auth_layout.html.twig' %}
{% import 'admin/_auth_macros.html.twig' as ui %}

{% block title %}Connexion{% endblock %}

{% block heading %}🔒 Portfolio Admin{% endblock %}

{% block content %}
    {% for message in app.flashes('success') %}
        {{ ui.success(message) }}
    {% endfor %}

    {% if error %}
        {{ ui.error(error.messageKey|trans(error.messageData, 'security')) }}
    {% endif %}

    <form method="post" class="flex flex-col gap-4">

        <div>
            {{ ui.label('email', 'Email') }}
            <input type="email" id="email" name="_username" value="{{ last_username }}"
                   autocomplete="email" autofocus
                   class="{{ ui.input_class() }}">
        </div>

        <div>
            {{ ui.label('password', 'Mot de passe') }}
            <input type="password" id="password" name="_password"
                   autocomplete="current-password"
                   class="{{ ui.input_class() }}">
        </div>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        {{ ui.submit('Se connecter') }}

        <div class="text-center">
            {{ ui.link(path('admin_forgot_password_request'), 'Mot de passe oublié ?') }}
        </div>

    </form>
{% endblock %}
