{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title %}Tableau de bord{% endblock %}

{% block main %}
<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:1rem;padding:1rem 0;">

    {% set links = [
        { label: 'Profil',           icon: 'fa fa-user',           entity: 'App\\Entity\\User' },
        { label: 'Projets',          icon: 'fa fa-code',           entity: 'App\\Entity\\Project' },
        { label: 'Skills',           icon: 'fa fa-star',           entity: 'App\\Entity\\Skill' },
        { label: 'Catégories',       icon: 'fa fa-folder',         entity: 'App\\Entity\\SkillCategory' },
        { label: 'Technologies',     icon: 'fa fa-wrench',         entity: 'App\\Entity\\Technology' },
        { label: 'Stats hero',       icon: 'fa fa-chart-bar',      entity: 'App\\Entity\\HeroStat' },
        { label: 'Phrases typing',   icon: 'fa fa-keyboard',       entity: 'App\\Entity\\HeroTyping' },
        { label: 'Paramètres',       icon: 'fa fa-cog',            entity: 'App\\Entity\\Setting' },
        { label: 'Mentions légales', icon: 'fa fa-scale-balanced', entity: 'App\\Entity\\Legal' },
    ] %}

    {% for item in links %}
    <a href="{{ ea_url().setController(item.entity) }}"
       onmouseover="this.style.opacity='.75'"
       onmouseout="this.style.opacity='1'"
       style="display:flex;flex-direction:column;align-items:center;justify-content:center;
              gap:.6rem;padding:1.75rem 1rem;
              background:var(--color-sidebar-menu-item-hover-bg);
              border:1px solid var(--color-border);
              border-radius:10px;text-decoration:none;color:inherit;
              transition:opacity .15s;cursor:pointer;">
        <i class="{{ item.icon }}" style="font-size:1.6rem;opacity:.8;"></i>
        <span style="font-size:.85rem;font-weight:500;text-align:center;">{{ item.label }}</span>
    </a>
    {% endfor %}

</div>
{% endblock %}