{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title %}Tableau de bord{% endblock %}

{% block main %}
<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:1rem;padding:1rem 0;">

    {% for item in links %}
    <a href="{{ ea_url().setController(item.controller) }}"
       onmouseover="this.style.opacity='.75'"
       onmouseout="this.style.opacity='1'"
       style="display:flex;flex-direction:column;align-items:center;justify-content:center;
              gap:.6rem;padding:1.75rem 1rem;
              background:var(--color-sidebar-menu-item-hover-bg);
              border:1px solid var(--color-border);
              border-radius:10px;text-decoration:none;color:inherit;
              transition:opacity .15s;cursor:pointer;">
        <i class="{{ item.icon }}" style="font-size:1.6rem;opacity:.8;"></i>
        <span style="font-size:.85rem;font-weight:500;text-align:center;">{{ item.label }}</span>
    </a>
    {% endfor %}

</div>
{% endblock %}