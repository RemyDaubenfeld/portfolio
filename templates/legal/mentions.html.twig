{% extends 'base.html.twig' %}

{% block title %}Mentions légales — {{ user.firstName }} {{ user.lastName}}{% endblock %}

{% block body %}

<nav class="fixed top-0 left-0 right-0 z-[100] flex items-center justify-between px-16 h-16 bg-bg/90 backdrop-blur-[14px] border-b border-border max-md:px-6">
    <a href="{{ path('app_home') }}" class="flex items-center gap-[0.65rem] no-underline">
        <img src="{{ asset('assets/img/logo.webp') }}" alt="Logo RD" class="w-[30px] h-[30px] rounded-full">
        <span class="font-display text-[0.9rem] font-semibold text-text">{{ user.firstName }}<span class="text-gold">{{ user.lastName}}</span></span>
    </a>
    <a href="{{ path('app_home') }}" class="font-mono text-[0.73rem] text-text-dim no-underline tracking-[0.06em] uppercase transition-colors duration-200 hover:text-gold">
        ← Retour
    </a>
</nav>

<main class="min-h-screen pt-32 pb-24 px-16 max-md:px-6">
    <div class="max-w-3xl mx-auto">

        <div class="mb-14">
            <p class="eyebrow-line font-mono text-[0.68rem] text-gold uppercase tracking-[0.12em] mb-4 flex items-center gap-3">
                Légal
            </p>
            <h1 class="font-display text-[clamp(2rem,4vw,3rem)] font-bold tracking-[-0.02em] leading-[1.1]">
                Mentions légales
            </h1>
        </div>

        <div class="flex flex-col gap-10">

            <div class="bg-bg2 border border-border rounded-[10px] p-8">
                <h3 class="font-display text-[1rem] font-semibold mb-4 text-gold">Éditeur du site</h3>
                <p class="text-[0.9rem] text-text-dim font-light leading-[1.8]">
                    {{ user.firstName }} {{ user.lastName}}<br>
                    Développeur Web — Portfolio personnel<br>
                    Contact : <a href="mailto:contact@remy-daubenfeld.fr" class="text-text hover:text-gold transition-colors duration-200">{{ user.email }}</a>
                </p>
            </div>

            <div class="bg-bg2 border border-border rounded-[10px] p-8">
                <h3 class="font-display text-[1rem] font-semibold mb-4 text-gold">Directeur de la publication</h3>
                <p class="text-[0.9rem] text-text-dim font-light leading-[1.8]">
                    {{ user.firstName }} {{ user.lastName}}, en qualité d'éditeur du site.
                </p>
            </div>

            <div class="bg-bg2 border border-border rounded-[10px] p-8">
                <h3 class="font-display text-[1rem] font-semibold mb-4 text-gold">Hébergement</h3>
                <p class="text-[0.9rem] text-text-dim font-light leading-[1.8]">
                    Le site remy-daubenfeld.fr est hébergé par :<br>
                    {{ legal.hostName }}
                    {{ legal.hostAddress | raw }}<br>
                    <a href="{{ legal.hostWebsite }}" target="_blank" rel="noopener" class="text-text hover:text-gold transition-colors duration-200">{{legal.hostWebsite}}</a><br>
                    Téléphone : {{ legal.hostPhone }}
                </p>
            </div>

            <div class="bg-bg2 border border-border rounded-[10px] p-8">
                <h3 class="font-display text-[1rem] font-semibold mb-4 text-gold">Propriété intellectuelle</h3>
                <p class="text-[0.9rem] text-text-dim font-light leading-[1.8]">
                    L'ensemble du contenu du site (textes, images, graphismes, code, etc.) est protégé par le droit d'auteur et appartient à {{ user.firstName }} {{ user.lastName}}, sauf mention contraire.
                    Toute reproduction, représentation, modification ou diffusion, totale ou partielle, sans autorisation expresse, est interdite.
                </p>
            </div>

            <div class="bg-bg2 border border-border rounded-[10px] p-8">
                <h3 class="font-display text-[1rem] font-semibold mb-4 text-gold">Données personnelles</h3>
                <p class="text-[0.9rem] text-text-dim font-light leading-[1.8]">
                    Ce site ne collecte aucune donnée personnelle via formulaire de contact.<br>
                    Conformément au RGPD, vous disposez d'un droit d'accès, de rectification, d'opposition et de suppression de vos données personnelles.
                    Vous pouvez exercer ces droits en écrivant à <a href="mailto:{{ user.email }}" class="text-text hover:text-gold transition-colors duration-200">{{ user.email }}</a>.
                </p>
            </div>

            <div class="bg-bg2 border border-border rounded-[10px] p-8">
                <h3 class="font-display text-[1rem] font-semibold mb-4 text-gold">Cookies</h3>
                <p class="text-[0.9rem] text-text-dim font-light leading-[1.8]">
                    Le site remy-daubenfeld.fr n'utilise pas de cookies publicitaires ni de traceurs à des fins de suivi.
                    Seules des données techniques strictement nécessaires au fonctionnement du site peuvent être traitées.
                </p>
            </div>

            <div class="bg-bg2 border border-border rounded-[10px] p-8">
                <h3 class="font-display text-[1rem] font-semibold mb-4 text-gold">Responsabilité</h3>
                <p class="text-[0.9rem] text-text-dim font-light leading-[1.8]">
                    {{ user.firstName }} {{ user.lastName}} met tout en œuvre pour assurer l'exactitude et la mise à jour des informations diffusées sur ce site.
                    Toutefois, aucune garantie n'est donnée quant à l'exactitude, la complétude ou l'actualité des informations publiées.
                    L'utilisateur est seul responsable de l'utilisation du contenu proposé.
                </p>
            </div>

            <div class="bg-bg2 border border-border rounded-[10px] p-8">
                <h3 class="font-display text-[1rem] font-semibold mb-4 text-gold">Droit applicable</h3>
                <p class="text-[0.9rem] text-text-dim font-light leading-[1.8]">
                    Le présent site et ses mentions légales sont soumis au droit français.
                    Tout litige sera de la compétence exclusive des tribunaux français.
                </p>
            </div>

            <p class="font-mono text-[0.65rem] text-text-mute tracking-[0.04em]">
                Dernière mise à jour : {{ "now"|date("d/m/Y") }}
            </p>

        </div>
    </div>
</main>

<footer class="px-16 py-7 flex justify-between items-center border-t border-border max-md:px-6 max-md:flex-col max-md:gap-2 max-md:text-center">
    <span class="font-mono text-[0.65rem] text-text-mute tracking-[0.04em]">© {{ "now"|date("Y") }} {{ user.firstName }} {{ user.lastName}}</span>
{% endblock %}