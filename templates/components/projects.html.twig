{% block projects %}
<section id="projects" class="px-16 py-24 border-b border-border max-md:px-6 max-md:py-16">
  <div class="flex items-baseline gap-5 mb-14">
    <span class="font-mono text-[0.65rem] text-gold uppercase tracking-[0.12em]">
        03
    </span>
    <h2 class="font-display text-[clamp(1.5rem,2.8vw,2.1rem)] font-semibold tracking-[-0.02em]">
        Projets
    </h2>
    <div class="flex-1 h-px bg-border max-w-[8rem]"></div>
  </div>

  <div class="flex flex-col gap-5">
    {% for project in projects %}
    <div class="group bg-bg2 border border-border rounded-[10px] px-8 py-7 grid grid-cols-[300px_1fr_auto] gap-8 items-start transition-all duration-200 hover:bg-bg3 hover:border-gold-dim">
    
    <!-- Colonne 1 : titre + image -->
    <div class="flex flex-col gap-4">
    <div class="flex items-center gap-3">
        <span class="font-mono text-[0.65rem] text-text-mute">0{{ loop.index }}</span>
        <span class="font-display text-[1.15rem] font-semibold leading-tight">{{ project.title }}</span>
        {% if project.inProgress %}
        <span class="font-mono text-[0.6rem] text-cyan border border-cyan-dim px-2 py-[0.1rem] tracking-[0.04em]">En cours</span>
        {% endif %}
    </div>
    {% if project.image %}
    <img src="{{ vich_uploader_asset(project, 'imageFile') }}" alt="{{ project.title }}"
         class="w-full aspect-video rounded-lg object-contain opacity-70 group-hover:opacity-100 transition-opacity duration-200">
    {% endif %}
</div>

    <!-- Colonne 2 : description + features + tags + liens téléchargement -->
    <div class="flex flex-col justify-between h-full mx-3">
        <p class="text-[0.88rem] text-text-dim font-light leading-[1.7] mt-[1.5rem] mb-[1.1rem]">
            {{ project.description }}
        </p>

        {% if project.features %}
        <ul class="mb-[1.1rem] flex flex-col gap-1">
            {% for feature in project.features %}
            <li class="flex items-start gap-2 text-[0.82rem] text-text-dim font-light">
                <span class="text-cyan mt-[0.15rem] shrink-0">›</span>
                {{ feature }}
            </li>
            {% endfor %}
        </ul>
        {% endif %}

        <div class="flex flex-wrap items-end gap-[0.6rem]">
            {% for tech in project.technologies %}
            <span class="font-mono text-[0.63rem] text-text-mute border border-border rounded px-2 py-[0.15rem] tracking-[0.04em] transition-all duration-150 group-hover:text-cyan group-hover:border-cyan-dim">
                {{ tech.name }}
            </span>
            {% endfor %}
        </div>
    </div>

    <!-- Colonne 3 : lien site ou github + lien dl -->
    <div class="flex flex-col justify-between items-end h-full">
        {% if project.url %}
        <a href="{{ project.url }}" target="_blank"
           class="font-mono text-[0.75rem] text-text-mute no-underline whitespace-nowrap mt-[1.5rem] transition-all duration-200 group-hover:text-gold">
            Voir le projet ↗
        </a>
        {% elseif project.githubUrl %}
        <a href="{{ project.githubUrl }}" target="_blank"
           class="font-mono text-[0.75rem] text-text-mute no-underline whitespace-nowrap mt-[1.5rem] transition-all duration-200 group-hover:text-gold">
            Voir sur GitHub ↗
        </a>
        {% endif %}

        {% if project.links %}
        <div class="flex flex-col items-end gap-5 mt-auto">
            {% for link in project.links %}
            <a href="{{ link.url }}" target="_blank"
               class="font-mono text-[0.7rem] text-gold border border-gold-dim px-3 py-[0.3rem] tracking-[0.05em] uppercase transition-all duration-200 hover:bg-gold hover:text-bg">
                ↓ {{ link.label }}
            </a>
            {% endfor %}
        </div>
        {% endif %}
    </div>
    

</div>
    {% endfor %}
</div>
</section>
{% endblock %}