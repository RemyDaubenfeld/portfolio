{% block skills %}
<section id="skills" class="px-16 py-24 border-b border-border max-md:px-6 max-md:py-16">
    <div class="flex items-baseline gap-5 mb-14">
        <span class="font-mono text-[0.65rem] text-gold uppercase tracking-[0.12em]">02</span>
        <h2 class="font-display text-[clamp(1.5rem,2.8vw,2.1rem)] font-semibold tracking-[-0.02em]">Stack technique</h2>
        <div class="flex-1 h-px bg-border max-w-[8rem]"></div>
    </div>

    <div class="flex flex-col gap-12">
    {% for skillsCat in skills_cats %}
    <div>
        <div class="skill-domain-before font-mono text-[0.75rem] text-gold uppercase tracking-[0.12em] mb-5 pb-[0.65rem] border-b border-border flex items-center gap-3">
            {{ skillsCat.name }}
        </div>
        <div class="flex flex-wrap gap-3">
            {% for skill in skillsCat.skills %}
            <div class="bg-bg2 border border-border rounded-lg px-4 py-[0.85rem] flex flex-col items-center gap-[0.55rem] w-20 transition-all duration-200 hover:bg-bg3 hover:border-cyan-dim cursor-default">
                <img src="{{ vich_uploader_asset(skill, 'iconFile') }}" alt="{{ skill.name }}" class="w-8 h-8 object-contain brightness-85 transition-[filter] duration-200 hover:brightness-110">
                <span class="font-mono text-[0.6rem] text-text text-center tracking-[0.03em] leading-[1.3]">
                    {{ skill.name }}
                </span>
            </div>
            {% endfor %}
        </div>
    </div>
    {% endfor %}
</div>
</section>

{% endblock %}