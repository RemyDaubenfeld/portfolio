<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">

        <title>{{ seo_config.metaTitle ?? 'Rémy Daubenfeld — Développeur Junior PHP/Symfony' }}</title>
        <link rel="icon" type="image/webp" href="{{ asset('assets/img/logo.webp') }}">

        {# Meta classiques #}
        {% if seo_config.metaDescription %}
            <meta name="description" content="{{ seo_config.metaDescription }}">
        {% endif %}
        {% if seo_config.metaKeywords %}
            <meta name="keywords" content="{{ seo_config.metaKeywords }}">
        {% endif %}
        <meta name="robots" content="{{ seo_config.robotsDirective ?? 'index,follow' }}">

        {# Canonical #}
        {% if seo_config.canonicalUrl %}
            <link rel="canonical" href="{{ seo_config.canonicalUrl }}">
        {% endif %}

        {# Open Graph #}
        <meta property="og:type" content="website">
        <meta property="og:title" content="{{ seo_config.ogTitle ?? seo_config.metaTitle ?? 'Rémy Daubenfeld' }}">
        <meta property="og:description" content="{{ seo_config.ogDescription ?? seo_config.metaDescription }}">
        <meta property="og:url" content="{{ seo_config.canonicalUrl ?? 'https://remy-daubenfeld.fr' }}">
        {% if seo_config.ogImage %}
            <meta property="og:image" content="{{ seo_config.ogImage }}">
        {% endif %}

        {# Twitter Card #}
        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:title" content="{{ seo_config.ogTitle ?? seo_config.metaTitle }}">
        <meta name="twitter:description" content="{{ seo_config.ogDescription ?? seo_config.metaDescription }}">

        {# Google Search Console #}
        {% if seo_config.googleVerificationToken %}
            <meta name="google-site-verification" content="{{ seo_config.googleVerificationToken }}">
        {% endif %}

        {# JSON-LD #}
        {% if seo_config.jsonLd %}
            <script type="application/ld+json">{{ seo_config.jsonLd | raw }}</script>
        {% endif %}
        
        {% block stylesheets %}
            <link rel="preconnect" href="https://fonts.googleapis.com">
            <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=DM+Sans:wght@300;400;500&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body>
        {% block body %}{% endblock %}

        <div data-controller="chat">
    <button
        data-action="click->chat#toggle"
        class="fixed bottom-8 right-8 w-14 h-14 rounded-full bg-[var(--color-gold)] border-none cursor-pointer z-[1000] shadow-lg shadow-black/30 transition-transform hover:scale-110 overflow-hidden p-0"
        aria-label="Ouvrir le chat"
    >
        <img src="{{ asset('assets/img/stagiaire-icon.webp') }}" alt="Stag'IA'ire" class="w-full h-full object-cover">
    </button>

    <div data-chat-target="widget" class="hidden fixed bottom-24 right-8 w-96 h-[480px] bg-[#1a1a1a] border border-[var(--color-gold)] rounded-2xl flex flex-col z-[1000] shadow-2xl shadow-black/50">
        <div class="px-4 py-3 border-b border-[var(--color-gold)] flex justify-between items-center text-[var(--color-gold)] font-semibold">
            <span class="flex items-center gap-2">
                <img src="{{ asset('assets/img/stagiaire-icon.webp') }}" alt="" class="w-6 h-6 rounded-full">
                Stag'IA'ire
            </span>
            <button data-action="click->chat#toggle" class="bg-transparent border-none text-[var(--color-gold)] cursor-pointer text-base" aria-label="Fermer le chat">✕</button>
        </div>

        <div data-chat-target="messages" class="flex-1 overflow-y-auto p-4 flex flex-col gap-3"></div>

        <form data-action="submit->chat#send" class="px-3 py-3 border-t border-neutral-800 flex gap-2">
            <input
                data-chat-target="input"
                type="text"
                placeholder="Posez une question..."
                autocomplete="off"
                class="flex-1 bg-neutral-800 border border-neutral-700 rounded-lg px-3 py-2 text-white text-sm focus:outline-none focus:border-[var(--color-cyan)]"
            />
            <button type="submit" class="bg-[var(--color-cyan)] text-black border-none rounded-lg px-4 py-2 cursor-pointer font-semibold">
                Envoyer
            </button>
        </form>
    </div>
</div>
    </body>
</html>
